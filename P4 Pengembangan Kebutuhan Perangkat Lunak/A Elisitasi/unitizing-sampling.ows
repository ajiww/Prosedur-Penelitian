		<properties node_id="13" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\x17\x00\x00\x00\xc8\x00\x00\x05\xcd\x00\x00\x04\xd3\x00\x00\x02\x17\x00\x00\x00\xc8\x00\x00\x05T\x00\x00\x03\x1f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x02\x17\x00\x00\x00\xc8\x00\x00\x05\xcd\x00\x00\x04\xd3', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, StringVariable\n\n# Define the column name (hyphen is safe here)\nnew_var = StringVariable("ID-Kode")\n\n# Generate incremental values: U_1, U_2, U_3, etc.\nn_rows = len(in_data)\nnew_values = [f"U_{i}" for i in range(1, n_rows + 1)]\n\n# Build the new domain including the meta attribute\nnew_domain = Domain(in_data.domain.attributes, \n                    in_data.domain.class_vars, \n                    in_data.domain.metas + (new_var,))\n\n# Merge old data with the new ID-Kode column\nnew_metas = np.column_stack((in_data.metas, np.array(new_values, dtype=object))) if in_data.metas.size &gt; 0 else np.array(new_values, dtype=object).reshape(-1, 1)\n\nout_data = Table.from_numpy(new_domain, in_data.X, in_data.Y, new_metas)', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, StringVariable\n\n# Define the column name (hyphen is safe here)\nnew_var = StringVariable("ID-Kode")\n\n# Generate incremental values: U_1, U_2, U_3, etc.\nn_rows = len(in_data)\nnew_values = [f"U_{i}" for i in range(1, n_rows + 1)]\n\n# Build the new domain including the meta attribute\nnew_domain = Domain(in_data.domain.attributes, \n                    in_data.domain.class_vars, \n                    in_data.domain.metas + (new_var,))\n\n# Merge old data with the new ID-Kode column\nnew_metas = np.column_stack((in_data.metas, np.array(new_values, dtype=object))) if in_data.metas.size &gt; 0 else np.array(new_values, dtype=object).reshape(-1, 1)\n\nout_data = Table.from_numpy(new_domain, in_data.X, in_data.Y, new_metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xac\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
